NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@ep-xxx-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Provide either REDIS_URL or both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6379
# UPSTASH_REDIS_REST_URL=https://your-upstash-host.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
GROQ_API_KEY=
GROQ_TIMEOUT_MS=15000
TAVILY_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
RUN_MIGRATIONS_ON_BOOT=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOG_LEVEL=info
